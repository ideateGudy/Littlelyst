# ==============================================================================
# LITTLELYST SERVER ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Application & Server Environment
NODE_ENV=development
PORT=5000

# Express Session Security & Cookie Expiration
SESSION_SECRET=your_express_session_secret_key_here
SESSION_MAX_AGE_DAYS=7

# Neon PostgreSQL Database Connections
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
MIGRATION_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT Access Token Configuration (Short-Lived: 15 minutes)
JWT_ACCESS_SECRET=your_access_token_secret_key_here
JWT_ACCESS_EXPIRES=15m

# JWT Refresh Token Configuration (Long-Lived: 7 days)
JWT_REFRESH_SECRET=your_refresh_token_secret_key_here
REFRESH_TOKEN_EXPIRES_DAYS=7

# CORS Security
ALLOWED_ORIGINS=http://localhost:3000

# Default Payment Gateway Strategy
DEFAULT_PAYMENT_GATEWAY=paystack

# Paystack API Keys
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...

# Flutterwave API Keys
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-...

# Stripe API Keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gmail / SMTP Email Notifications (OAuth2)
EMAIL_USER=your_email@gmail.com
CLIENT_ID=your_oauth2_client_id
CLIENT_SECRET=your_oauth2_client_secret
REFRESH_TOKEN=your_oauth2_refresh_token
